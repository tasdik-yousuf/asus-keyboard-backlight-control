#!/usr/bin/env bash
# kbd-backlight-idle
#
# ASUS keyboard backlight: turns OFF after IDLE_TIMEOUT seconds of no
# keyboard OR mouse activity, and back ON to whatever level was active
# before it went idle (not a hardcoded level) the moment you type,
# click, move, or scroll.
#
# Must be run as root (brightnessctl needs root to write the kbd
# backlight, and evtest needs root to read /dev/input):
#
#   sudo kbd-backlight-idle
#
# Requires: brightnessctl, evtest, libinput

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    echo "Run this as root: sudo $0" >&2
    exit 1
fi

# ---- Config -----------------------------------------------------------
# Defaults, overridable by /etc/kbd-backlight-idle.conf
DEVICE="asus::kbd_backlight"   # confirm with: brightnessctl -l
IDLE_TIMEOUT=10                # seconds of inactivity before turning off
FALLBACK_LEVEL="50%"           # used only if the backlight is already off when the script starts

for conf in /etc/kbd-backlight-idle.conf "$(dirname "$0")/../config/kbd-backlight-idle.conf"; do
    if [[ -f "$conf" ]]; then
        # shellcheck source=/dev/null
        source "$conf"
        break
    fi
done
# ------------------------------------------------------------------------

STATE_DIR="/run/kbd-backlight-idle"
mkdir -p "$STATE_DIR"
LEVEL_FILE="$STATE_DIR/last_level"
ACTIVITY_FILE="$STATE_DIR/last_activity"

date +%s > "$ACTIVITY_FILE"

# Finds a /dev/input/eventN device by libinput capability (keyboard | pointer)
find_device() {
    local cap="$1"
    libinput list-devices 2>/dev/null \
        | awk -v RS="" -v cap="$cap" '$0 ~ ("Capabilities:.*" cap) {print; exit}' \
        | grep '^Kernel:' | awk '{print $2}'
}

KBD_EVENT=$(find_device keyboard)
MOUSE_EVENT=$(find_device pointer)

if [[ -z "${KBD_EVENT:-}" && -z "${MOUSE_EVENT:-}" ]]; then
    echo "Couldn't auto-detect a keyboard or mouse device." >&2
    echo "Run: libinput list-devices   and hardcode KBD_EVENT / MOUSE_EVENT below." >&2
    exit 1
fi

[[ -n "${KBD_EVENT:-}" ]]   && echo "Keyboard:  $KBD_EVENT"
[[ -z "${KBD_EVENT:-}" ]]   && echo "Keyboard:  not found, continuing with mouse only" >&2
[[ -n "${MOUSE_EVENT:-}" ]] && echo "Mouse:     $MOUSE_EVENT"
[[ -z "${MOUSE_EVENT:-}" ]] && echo "Mouse:     not found, continuing with keyboard only" >&2

# Remember whatever level is currently set. If the backlight happens to
# already be off when we start, fall back to FALLBACK_LEVEL so there's
# something sensible to restore to later.
CURRENT=$(brightnessctl --device="$DEVICE" get)
if (( CURRENT > 0 )); then
    echo "$CURRENT" > "$LEVEL_FILE"
else
    brightnessctl --device="$DEVICE" set "$FALLBACK_LEVEL" >/dev/null
    brightnessctl --device="$DEVICE" get > "$LEVEL_FILE"
fi

echo "Backlight: off after ${IDLE_TIMEOUT}s idle, restores to whatever level was last set. Ctrl+C to stop."

wake() {
    date +%s > "$ACTIVITY_FILE"
    local level
    level=$(cat "$LEVEL_FILE" 2>/dev/null || echo "$FALLBACK_LEVEL")
    brightnessctl --device="$DEVICE" set "$level" >/dev/null 2>&1 || true
}

PIDS=()
cleanup() {
    for pid in "${PIDS[@]:-}"; do
        kill "$pid" 2>/dev/null || true
    done
}
trap cleanup INT TERM EXIT

# Background watcher: turns backlight off once idle timeout is hit,
# remembering the level it was at right before doing so.
(
    STATE="on"
    while true; do
        sleep 1
        NOW=$(date +%s)
        LAST=$(cat "$ACTIVITY_FILE" 2>/dev/null || echo "$NOW")
        if (( NOW - LAST >= IDLE_TIMEOUT )) && [[ "$STATE" == "on" ]]; then
            CUR=$(brightnessctl --device="$DEVICE" get)
            if (( CUR > 0 )); then
                echo "$CUR" > "$LEVEL_FILE"
            fi
            brightnessctl --device="$DEVICE" set 0 >/dev/null 2>&1 || true
            STATE="off"
        elif (( NOW - LAST < IDLE_TIMEOUT )) && [[ "$STATE" == "off" ]]; then
            STATE="on"
        fi
    done
) &
PIDS+=("$!")

# Keyboard listener: any keydown wakes the backlight
if [[ -n "${KBD_EVENT:-}" ]]; then
    (
        evtest "$KBD_EVENT" 2>/dev/null | while read -r line; do
            if [[ "$line" == *"type 1 (EV_KEY)"* && "$line" == *"value 1"* ]]; then
                wake
            fi
        done
    ) &
    PIDS+=("$!")
fi

# Mouse listener: movement, clicks, or scroll wake the backlight
# (anything but the EV_SYN sync marker evtest prints after each event batch)
if [[ -n "${MOUSE_EVENT:-}" ]]; then
    (
        evtest "$MOUSE_EVENT" 2>/dev/null | while read -r line; do
            if [[ "$line" == *"Event: time"* && "$line" != *"EV_SYN"* ]]; then
                wake
            fi
        done
    ) &
    PIDS+=("$!")
fi

wait
