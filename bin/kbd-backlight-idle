#!/usr/bin/env bash

set -euo pipefail

if [[ $EUID -ne 0 ]]; then
    echo "Run this as root: sudo $0" >&2
    exit 1
fi

DEVICE="asus::kbd_backlight"
IDLE_TIMEOUT=10
FALLBACK_LEVEL="50%"

for conf in /etc/kbd-backlight-idle.conf "$(dirname "$0")/../config/kbd-backlight-idle.conf"; do
    if [[ -f "$conf" ]]; then
        # shellcheck source=/dev/null
        source "$conf"
        break
    fi
done

STATE_DIR="/run/kbd-backlight-idle"
mkdir -p "$STATE_DIR"
LEVEL_FILE="$STATE_DIR/last_level"
ACTIVITY_FILE="$STATE_DIR/last_activity"
STATE_FILE="$STATE_DIR/state"

date +%s > "$ACTIVITY_FILE"


KBD_EVENT=$(libinput list-devices 2>/dev/null | awk '
  /^Device:/ {name=$0}
  /Kernel:/  {if (name ~ /[Kk]eyboard/) print $2}' | head -n1)

if [[ -z "${KBD_EVENT:-}" ]]; then
    echo "Couldn't auto-detect a keyboard device." >&2
    echo "Run: libinput list-devices   and hardcode KBD_EVENT below (e.g. /dev/input/event5)." >&2
    exit 1
fi

MOUSE_EVENT=$(libinput list-devices 2>/dev/null | awk '
  /^Device:/ {name=$0}
  /Kernel:/  {if (name ~ /[Mm]ouse/) print $2}' | head -n1)

if [[ -z "${MOUSE_EVENT:-}" ]]; then
    echo "No mouse device auto-detected — continuing with keyboard only." >&2
fi

TOUCHPAD_EVENT=$(libinput list-devices 2>/dev/null | awk '
  /^Device:/ {name=$0}
  /Kernel:/  {if (name ~ /[Tt]ouchpad/) print $2}' | head -n1)

if [[ -z "${TOUCHPAD_EVENT:-}" ]]; then
    echo "No touchpad device auto-detected." >&2
fi

CURRENT=$(brightnessctl --device="$DEVICE" get)
if (( CURRENT > 0 )); then
    echo "$CURRENT" > "$LEVEL_FILE"
    echo "on" > "$STATE_FILE"
else
    echo "$FALLBACK_LEVEL" > "$LEVEL_FILE"
    echo "user-off" > "$STATE_FILE"
fi

echo "Keyboard:  $KBD_EVENT"
[[ -n "${MOUSE_EVENT:-}" ]] && echo "Mouse:     $MOUSE_EVENT"
[[ -n "${TOUCHPAD_EVENT:-}" ]] && echo "Touchpad:  $TOUCHPAD_EVENT"
echo "Backlight: off after ${IDLE_TIMEOUT}s idle, restores to whatever level was last set. Ctrl+C to stop."

cleanup() {
    kill "${IDLE_PID:-0}" "${MOUSE_PID:-0}" "${TOUCHPAD_PID:-0}" 2>/dev/null || true
}
trap cleanup INT TERM EXIT

# Idle timer
(
    while true; do
        sleep 1
        CUR=$(brightnessctl --device="$DEVICE" get)
        CURSTATE=$(cat "$STATE_FILE" 2>/dev/null || echo "on")

        case "$CURSTATE" in
            on)
                if (( CUR == 0 )); then
                    echo "user-off" > "$STATE_FILE"
                else
                    echo "$CUR" > "$LEVEL_FILE"
                    NOW=$(date +%s)
                    LAST=$(cat "$ACTIVITY_FILE" 2>/dev/null || echo "$NOW")
                    if (( NOW - LAST >= IDLE_TIMEOUT )); then
                        brightnessctl --device="$DEVICE" set 0 >/dev/null 2>&1 || true
                        echo "auto-off" > "$STATE_FILE"
                    fi
                fi
                ;;
            auto-off|user-off)
                if (( CUR > 0 )); then
                    echo "$CUR" > "$LEVEL_FILE"
                    echo "on" > "$STATE_FILE"
                fi
                ;;
        esac
    done
) &
IDLE_PID=$!

# Mouse listener
if [[ -n "${MOUSE_EVENT:-}" ]]; then
    (
        evtest "$MOUSE_EVENT" 2>/dev/null | while read -r line; do
            if [[ "$line" == *"Event: time"* && "$line" != *"EV_SYN"* ]]; then
                date +%s > "$ACTIVITY_FILE"
                if [[ "$(cat "$STATE_FILE" 2>/dev/null || echo on)" == "auto-off" ]]; then
                    LEVEL=$(cat "$LEVEL_FILE" 2>/dev/null || echo "$FALLBACK_LEVEL")
                    brightnessctl --device="$DEVICE" set "$LEVEL" >/dev/null 2>&1 || true
                    echo "on" > "$STATE_FILE"
                fi
            fi
        done
    ) &
    MOUSE_PID=$!
fi

# Touchpad listener
if [[ -n "${TOUCHPAD_EVENT:-}" ]]; then
    (
        evtest "$TOUCHPAD_EVENT" 2>/dev/null | while read -r line; do
            if [[ "$line" == *"Event: time"* && "$line" != *"EV_SYN"* ]]; then
                date +%s > "$ACTIVITY_FILE"
                if [[ "$(cat "$STATE_FILE" 2>/dev/null || echo on)" == "auto-off" ]]; then
                    LEVEL=$(cat "$LEVEL_FILE" 2>/dev/null || echo "$FALLBACK_LEVEL")
                    brightnessctl --device="$DEVICE" set "$LEVEL" >/dev/null 2>&1 || true
                    echo "on" > "$STATE_FILE"
                fi
            fi
        done
    ) &
    TOUCHPAD_PID=$!
fi

# Keyboard listener
evtest "$KBD_EVENT" 2>/dev/null | while read -r line; do
    if [[ "$line" == *"type 1 (EV_KEY)"* && "$line" == *"value 1"* ]]; then
        date +%s > "$ACTIVITY_FILE"
        if [[ "$(cat "$STATE_FILE" 2>/dev/null || echo on)" == "auto-off" ]]; then
            LEVEL=$(cat "$LEVEL_FILE" 2>/dev/null || echo "$FALLBACK_LEVEL")
            brightnessctl --device="$DEVICE" set "$LEVEL" >/dev/null 2>&1 || true
            echo "on" > "$STATE_FILE"
        fi
    fi
done
